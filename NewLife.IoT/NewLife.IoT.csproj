<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 目标框架对齐 NewLife.Core v12：net7.0/net9.0 已由 Core 侧合并（net7.0→net6.0，net9.0→net8.0），
         保留会被 NuGet 回退到 netstandard2.1 资产 -->
    <TargetFrameworks>net45;net461;net462;netstandard2.0;netstandard2.1;net6.0;net8.0;net10.0</TargetFrameworks>
    <AssemblyTitle>IoT Standard Library (IoT标准库)</AssemblyTitle>
    <Description>IoT Standard Library — defines unified communication protocol contracts for IoT platforms and hardware drivers. No concrete protocol implementations. Async-first IDriver with structured results: ReadResult (Quality/Timestamp), WriteResult (zero-allocation struct), ControlResult. ThingSpec thing model for properties/events/services. ITransport unifies serial/TCP/UDP/HTTP transport.  |  IoT标准库，为物联网平台与硬件驱动定义统一通信协议契约，不含具体协议实现。异步优先IDriver配合结构化结果。ThingSpec物模型。ITransport统一传输层。</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 新生命开发团队</Copyright>
    <VersionPrefix>3.1</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>CA2007;IL2026;IL2070;IL2072;IL2075;IL3050</WarningsAsErrors>
    <NoWarn>1701;1702;NU5104;NETSDK1138;CS7035;SYSLIB1224</NoWarn>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <!-- net8.0+ 常驻启用 AOT 兼容性分析（对齐 NewLife.Core v12），net6.0 及以下不适用 -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/iot</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.IoT</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>IoT;Internet of Things;IDriver;DriverBase;ThingSpec;DataQuality;Modbus;Siemens;OPC-UA;Edge Computing;Industrial Automation;Protocol;Async;NewLife;物联网;物模型;边缘计算;工业自动化;协议;异步;新生命团队;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>v3.1 — Async interface for IModbus/IRelayController/IDevice with CancellationToken &amp; async report; new DriverCodec shared codec (HEX/ASCII/UTF8/Json); zero-allocation hot paths in DataHelper/TypeHelper; serial/network driver concurrency &amp; timeout fixes; 130+ new tests, 372 all pass.  v3.1 — IModbus/IRelayController/IDevice接口异步化，支持取消令牌与异步上报；新增DriverCodec共享编解码助手；采集热点路径零分配化；修复串口/网络驱动并发安全与超时缺陷；新增130+单元测试全部通过。</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- 非 Windows 构建 net45/net461/net462 需要引用程序集包，Windows 已安装目标包时可忽略 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="$(TargetFramework.StartsWith('net4'))" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1019-beta0659" />
  </ItemGroup>

  <!-- 多语言词表：编译期由 NewLife.Core 源生成器打包进程序集，运行时自动注册 -->
  <ItemGroup>
    <AdditionalFiles Include="..\Locales\*.yml" Link="Locales\%(Filename)%(Extension)" />
    <Compile Include="..\Common\ModuleInitializerAttribute.cs" Link="Common\ModuleInitializerAttribute.cs" />
    <Compile Include="..\Common\JsonSerializableStub.cs" Link="Common\JsonSerializableStub.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
